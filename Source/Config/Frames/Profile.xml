<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="LogisticianConfigProfileFrameTemplate"
    mixin="LogisticianConfigProfileFrameMixin"
    virtual="true">

    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnShow method="OnShow"/>
      <OnHide method="Save"/>
    </Scripts>

    <Frames>
      <Frame inherits="LogisticianConfigurationTitleFrame" parentKey="TitleArea">
        <KeyValues>
          <KeyValue key="titleText" value="LOGISTICIAN_L_CONFIG_PROFILE_CATEGORY" type="global" />
          <KeyValue key="subTitleText" value="LOGISTICIAN_L_CONFIG_PROFILE_TEXT" type="global"/>
        </KeyValues>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="ProfileToggle">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_PROFILE_TOGGLE" type="global"/>
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_PROFILE_TOGGLE_TOOLTIP_HEADER" type="global"/>
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_PROFILE_TOGGLE_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.TitleArea" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>
    </Frames>
  </Frame>
</Ui>
