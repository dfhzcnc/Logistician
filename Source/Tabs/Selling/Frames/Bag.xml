<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="LogisticianSellingBagFrame"
    virtual="true"
    parentKey="BagListing"
    mixin="LogisticianBagUseMixin"
  >
    <Scripts>
      <OnLoad method="OnLoad" />
      <OnShow method="OnShow" />
      <OnHide method="OnHide" />
    </Scripts>

    <Frames>
      <Frame inherits="LogisticianGroupsViewTemplate">
        <KeyValues>
          <KeyValue key="itemTemplate" value="LogisticianGroupsViewItemTemplate" type="string" />
          <KeyValue key="groupTemplate" value="LogisticianSellingViewGroupTemplate" type="string" />
          <KeyValue key="clickEventName" value="BagUse.BagItemClicked" type="string" />
          <KeyValue key="hideHiddenItems" value="true" type="boolean" />
          <KeyValue key="applyVisibility" value="true" type="boolean" />
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT"/>
          <Anchor point="BOTTOMRIGHT"/>
        </Anchors>
      </Frame>
    </Frames>
  </Frame>
</Ui>
