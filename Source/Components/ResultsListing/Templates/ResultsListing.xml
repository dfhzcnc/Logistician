<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="AuctionatorResultsListingTemplate"
    virtual="true"
    parentKey="ResultsListing"
    mixin="AuctionatorResultsListingMixin"
  >

    <Scripts>
      <OnShow method="OnShow" />
    </Scripts>

    <Frames>
      <Frame parentKey="HeaderContainer">
        <Size y="19"/>
        <Anchors>
          <Anchor point="TOPLEFT" y="-7" x="-20" />
          <Anchor point="RIGHT"/>
        </Anchors>
      </Frame>

      <Frame parentKey="ScrollArea">
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.HeaderContainer" relativePoint="BOTTOMLEFT" y="-3" x="15"/>
          <Anchor point="RIGHT" relativeKey="$parent.HeaderContainer" relativePoint="RIGHT" x="-3"/>
          <Anchor point="BOTTOM" relativeKey="$parent" relativePoint="BOTTOMRIGHT" y="4"/>
        </Anchors>
        <Frames>
          <Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
            <Anchors>
              <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
              <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
            </Anchors>
          </Frame>
          <EventFrame parentKey="ScrollBar" inherits="WowTrimScrollBar">
              <Anchors>
                  <Anchor point="TOPLEFT" relativePoint="TOPRIGHT"/>
                  <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT"/>
              </Anchors>
          </EventFrame>
        </Frames>
        <Layers>
          <Layer level="OVERLAY">
            <FontString parentKey="NoResultsText" inherits="GameFontNormal" hidden="true" text="AUCTIONATOR_L_NO_RESULTS">
              <Anchors>
                <Anchor point="CENTER" />
              </Anchors>
              <Shadow x="1" y="-1">
                <Color r="0" g="0" b="0"/>
              </Shadow>
            </FontString>
          </Layer>
        </Layers>
        <Frames>
          <!-- Bordered "Fetching item info" box shown while results are loading, universal
               across every tab that uses this results listing. -->
          <Frame parentKey="FetchingInfoDialog" frameStrata="DIALOG" hidden="true">
            <KeyValues>
              <KeyValue key="layoutType" value="Dialog" type="string"/>
            </KeyValues>
            <Size x="338" y="50"/>
            <Anchors>
              <Anchor point="CENTER"/>
            </Anchors>
            <Layers>
              <Layer>
                <FontString parentKey="StatusText" inherits="GameFontHighlight" text="AUCTIONATOR_L_FETCHING_ITEM_INFO">
                  <Anchors>
                    <Anchor point="CENTER"/>
                  </Anchors>
                </FontString>
              </Layer>
              <Layer level="BACKGROUND" textureSubLevel="-6">
                <Texture parentKey="Background">
                  <Anchors>
                    <Anchor point="TOPLEFT" x="6" y="-8"/>
                    <Anchor point="BOTTOMRIGHT" x="-6" y="8"/>
                  </Anchors>
                  <Color r="0" g="0" b="0" a="0.8"/>
                </Texture>
              </Layer>
            </Layers>
            <Frames>
              <Frame parentKey="NineSlice" inherits="NineSlicePanelTemplate" />
            </Frames>
            <Animations>
              <AnimationGroup parentKey="PulseAnim" looping="BOUNCE">
                <Alpha childKey="StatusText" fromAlpha="0.3" toAlpha="1" duration="0.5" smoothing="IN_OUT"/>
              </AnimationGroup>
            </Animations>
          </Frame>
        </Frames>
      </Frame>
    </Frames>
  </Frame>
</Ui>
