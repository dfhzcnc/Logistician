<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="LogisticianConfigBasicOptionsFrameTemplate"
    mixin="LogisticianConfigBasicOptionsFrameMixin"
    virtual="true">

    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnShow method="OnShow"/>
      <OnHide method="Save"/>
    </Scripts>

    <Frames>
      <Frame inherits="LogisticianConfigurationTitleFrame" parentKey="TitleArea">
        <KeyValues>
          <KeyValue key="titleText" value="LOGISTICIAN_L_CONFIG_BASIC_OPTIONS_CATEGORY" type="global" />
          <KeyValue key="subTitleText" value="LOGISTICIAN_L_CONFIG_BASIC_OPTIONS_TEXT" type="global"/>
        </KeyValues>
      </Frame>

      <Frame inherits="LogisticianConfigurationHeadingFrame" parentKey="DefaultTabHeading">
        <KeyValues>
          <KeyValue key="headingText" value="LOGISTICIAN_L_DEFAULT_TAB" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.TitleArea" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianDropDown" parentKey="DefaultTab">
       <KeyValues>
         <KeyValue key="labelText" value="LOGISTICIAN_L_DEFAULT_TAB_TEXT" type="global"/>
         <KeyValue key="textString" value="NONE;SHOPPING_TAB;SELLING_TAB;CANCELLING_TAB;LOGISTICIAN"/>
         <KeyValue key="valuesString" value="0;1;2;3;4"/>
       </KeyValues>
       <Anchors>
         <Anchor point="TOPLEFT" relativeKey="$parent.DefaultTabHeading" relativePoint="BOTTOMLEFT"/>
       </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationHeadingFrame" parentKey="CraftingInfoHeading">
        <KeyValues>
          <KeyValue key="headingText" value="LOGISTICIAN_L_CRAFTING_INFO" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.DefaultTab" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="ShowCraftingInfo">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW" type="global" />
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW_TOOLTIP_HEADER" type="global" />
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.CraftingInfoHeading" relativePoint="BOTTOMLEFT" />
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="ShowCraftingCost">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW_COST" type="global" />
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW_COST_TOOLTIP_HEADER" type="global" />
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW_COST_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.ShowCraftingInfo" relativePoint="BOTTOMLEFT" />
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="ShowCraftingProfit">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW_PROFIT" type="global" />
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW_PROFIT_TOOLTIP_HEADER" type="global" />
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_CONFIG_CRAFTING_INFO_SHOW_PROFIT_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.ShowCraftingCost" relativePoint="BOTTOMLEFT" />
        </Anchors>
      </Frame>
   </Frames>
  </Frame>
</Ui>
