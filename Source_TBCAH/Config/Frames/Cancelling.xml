<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="LogisticianConfigCancellingFrameTemplate"
    mixin="LogisticianConfigCancellingFrameMixin"
    virtual="true">

    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnShow method="OnShow"/>
      <OnHide method="Save"/>
    </Scripts>

    <Frames>
      <Frame inherits="LogisticianConfigurationTitleFrame" parentKey="TitleArea">
        <KeyValues>
          <KeyValue key="titleText" value="LOGISTICIAN_L_CONFIG_CANCELLING_CATEGORY" type="global" />
          <KeyValue key="subTitleText" value="LOGISTICIAN_L_CONFIG_CANCELLING_TEXT" type="global"/>
        </KeyValues>
      </Frame>

      <Frame inherits="LogisticianConfigurationNumericInput" parentKey="UndercutItemsAhead">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_UNDERCUT_ITEMS_AHEAD_CLASSIC" type="global"/>
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_CONFIG_UNDERCUT_ITEMS_AHEAD_TOOLTIP_HEADER" type="global"/>
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_UNDERCUT_ITEMS_AHEAD_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.TitleArea" relativePoint="BOTTOMLEFT" />
        </Anchors>
      </Frame>

      <Frame parentKey="CancelUndercutShortcut" inherits="LogisticianKeyBindingConfigTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.UndercutItemsAhead" relativePoint="BOTTOMLEFT"/>
        </Anchors>
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_CANCEL_UNDERCUT_SHORTCUT" type="global"/>
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_CONFIG_CANCEL_UNDERCUT_SHORTCUT_TOOLTIP_TEXT" type="global"/>
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_CUSTOM_KEYBOARD_SHORTCUTS" type="global"/>
        </KeyValues>
      </Frame>
   </Frames>
  </Frame>
</Ui>
