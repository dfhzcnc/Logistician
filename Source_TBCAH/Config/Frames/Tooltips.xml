<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="LogisticianConfigTooltipsFrameTemplate"
    mixin="LogisticianConfigTooltipsFrameMixin"
    virtual="true">

    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnShow method="OnShow"/>
      <OnHide method="Save"/>
    </Scripts>

    <Frames>
      <Frame inherits="LogisticianConfigurationTitleFrame" parentKey="TitleArea">
        <KeyValues>
          <KeyValue key="titleText" value="LOGISTICIAN_L_CONFIG_TOOLTIPS_CATEGORY" type="global" />
          <KeyValue key="subTitleText" value="LOGISTICIAN_L_CONFIG_TOOLTIPS_TEXT" type="global"/>
        </KeyValues>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="AuctionTooltips">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_AUCTION_TOOLTIP" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.TitleArea" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="MailboxTooltips">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_MAIL_TOOLTIP" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.AuctionTooltips" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="VendorTooltips">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_VENDOR_TOOLTIP" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.MailboxTooltips" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="EnchantTooltips">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_ENCHANT_GENERIC_TOOLTIP" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.VendorTooltips" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="ProspectTooltips">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_PROSPECT_TOOLTIP" type="global"/>
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_PROSPECT_TOOLTIP_TOOLTIP_HEADER" type="global"/>
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_PROSPECT_TOOLTIP_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.EnchantTooltips" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="MillTooltips">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_MILL_TOOLTIP" type="global"/>
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_MILL_TOOLTIP_TOOLTIP_HEADER" type="global"/>
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_MILL_TOOLTIP_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.ProspectTooltips" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="AuctionAgeTooltips">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_AUCTION_AGE_TOOLTIP" type="global"/>
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_AUCTION_AGE_TOOLTIP_TOOLTIP_HEADER" type="global"/>
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_AUCTION_AGE_TOOLTIP_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.MillTooltips" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame inherits="LogisticianConfigurationCheckbox" parentKey="ShiftStackTooltips">
        <KeyValues>
          <KeyValue key="labelText" value="LOGISTICIAN_L_CONFIG_STACK_TOOLTIP" type="global"/>
          <KeyValue key="tooltipTitleText" value="LOGISTICIAN_L_STACK_TOOLTIP_TOOLTIP_HEADER" type="global"/>
          <KeyValue key="tooltipText" value="LOGISTICIAN_L_STACK_TOOLTIP_TOOLTIP_TEXT" type="global"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.AuctionAgeTooltips" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>
    </Frames>
  </Frame>
</Ui>
